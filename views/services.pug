extends base

block content2
  style.

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      font-weight: 700;

      color: white;
      text-align: center;

    }
    h1,h2,h3 {
      font-weight: 700;
      margin-bottom: 0.5rem;
    }
    .header-section {
      margin-top: 3rem;

    }
    .header-section h1 {
      font-size: 3rem;
      background: linear-gradient(to left, #A7F3D0, #34D399, #10B981);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      display: inline-block;
    }
    .header-section p {
      color: #ccc;
      font-size: 1.2rem;
      max-width: 600px;
      margin: 0.5rem auto 0 auto;
      line-height: 1.4;
    }
    /* Redesigned animation section */
    .animation-section {
    background: rgba(0, 0, 0, 0.5) url('assets/Simple Shiny (3).svg') center/cover no-repeat;
    border-radius: 20px;
    padding: 3rem 2rem;
    margin: 3.5rem auto;
    max-width: 1100px; /* Default width */
    box-shadow: 0 0 25px rgba(0, 255, 100, 0.2);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: center;
    }

    /* Make wider on large screens */
    @media (min-width: 1400px) {
    .animation-section {
        max-width: 1400px;  /* Wider on desktops/large monitors */
        padding: 4rem 3rem; /* Slightly more breathing room */
    }
    }

    .animation-box {
    background: rgba(0, 0, 0, 0.45);
    border: 1px solid rgba(0,255,100,0.4);
    border-radius: 16px;
    padding: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 350px;
    width: 350px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .animation-box:hover {
    transform: scale(1.03);
    box-shadow: 0 0 30px rgba(0, 255, 100, 0.4);
    }

    .animation-text {
    text-align: right;
    direction: rtl;
    padding: 1rem;
    }

    .animation-text h2 {
    font-size: 1.8rem;
    margin-bottom: 0.5rem;
    }

    .animation-text span {
    background: linear-gradient(to right, #2EC84D, #1BAF3A, #26914cff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
    }

    .animation-text p {
    color: #bbb;
    line-height: 1.6;
    margin-top: 1rem;
    font-size: 1.05rem;
    max-width: 500px;
    }

    /* Responsiveness */
    @media (max-width: 600px) {
    .animation-section {
        background: rgba(0, 0, 0, 0.5) url('assets/Simple Shiny (2).svg') center/cover no-repeat;
        grid-template-columns: 1fr;
        padding: 2rem 1.5rem;
        align-items: center;
        justify-content: center;
    }

    .animation-box {
        height: 150px;
    }

    .animation-text {
        text-align: center;
        direction: rtl;
        padding: 0;
    }

    .animation-text h2 {
        font-size: 1.6rem;
    }
    }

    @media (max-width: 600px) {
    .header-section h1 {
        font-size: 2.3rem;
    }

    .animation-box {
        height: 220px;
        width: 220px;
    }

    .animation-text p {
        font-size: 0.95rem;
    }
    }

    /* Pricing grid - Updated for 2 cards */
    .pricing-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr); /* Changed from 3 to 2 */
      gap: 3rem; /* Increased gap for better spacing */
      max-width: 800px; /* Reduced max-width for 2 cards */
      margin: 8rem auto; /* Centers the entire grid horizontally */
      text-align: center;
      justify-items: center; /* Center the cards within their grid cells */
    }

    /* Large screens - keep 2 columns but with more space */
    @media (min-width: 1200px) {
      .pricing-grid {
        max-width: 900px;
        gap: 4rem;
      }
    }

    .pricing-card {
      background: rgba(0,0,0,0.55);
      border: 1.5px solid #166534;
      border-radius: 20px;
      padding: 2rem 0.2rem 2.5rem 0.2rem;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.3s ease;
      width: 100%; /* Allow card to take full width of its grid cell */
      max-width: 375px; /* Set max-width to control its size */
      box-shadow: inset 0 0 10px rgba(0,255,100,0.1);
      text-align: center;
      align-items: center;
    }

    /* Mobile responsiveness - stack cards vertically */
    @media (max-width: 768px) {
      .pricing-grid {
        grid-template-columns: 1fr; /* Single column on mobile */
        max-width: 400px;
        gap: 2rem;
      }
      
      .upsells {
        flex-direction: column;
        width: 95%;
      }
      .upsell-card {
        height: 200px;
        width: 300px;
      }
      .animation-section {
        flex-direction: column;
        width: 95%;
      }
      .animation-box {
        width: 90vw;
        max-width: 350px;
        height: auto;
      }
      .animation-text {
        max-width: 90vw;
      }
      .summary-section {
        width: 95vw;
      }
      .summary-details {
        flex-direction: column;
        gap: 1rem;
      }
      .summary-item {
        width: 100%;
        max-width: 300px;
      }
    }

    /* Additional media query for very small screens */
    @media (max-width: 450px) {
      .pricing-grid {
        max-width: 90vw;
      }
    }

    .pricing-card:hover {
      transform: translateY(-8px);

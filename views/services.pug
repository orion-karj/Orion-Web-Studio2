  script(src="https://cdnjs.cloudflare.com/ajax/libs/bodymovin/5.7.4/lottie.min.js")
  script.
    // State management
    let selectedPlan = null;
    let selectedUpsells = [];

    // Initialize Lottie animation
    const container = document.getElementById('lottie-container');
    if (container) {
      lottie.loadAnimation({
        container: container,
        renderer: 'svg',
        loop: true,
        autoplay: true,
        path: 'https://lottie.host/f18ed6ab-0125-4a53-8a6c-6a55704e9f62/sMe0luVNjF.json'
      });
    }

    // Plan selection handlers
    document.querySelectorAll('.plan-card').forEach(card => {
      card.addEventListener('click', () => {
        // Remove selected class from all cards
        document.querySelectorAll('.plan-card').forEach(c => c.classList.remove('selected'));
        // Add selected class to clicked card
        card.classList.add('selected');
        // Update selected plan
        selectedPlan = card.dataset.plan;
        // Capitalize first letter
        selectedPlan = selectedPlan.charAt(0).toUpperCase() + selectedPlan.slice(1);
        updateSummary();
      });
    });

    // Upsell selection handlers
    document.querySelectorAll('.upsell-card').forEach(card => {
      card.addEventListener('click', () => {
        const upsellName = card.dataset.upsell;
        
        // Toggle selected class
        card.classList.toggle('selected');
        
        // Toggle upsell in array
        if (selectedUpsells.includes(upsellName)) {
          selectedUpsells = selectedUpsells.filter(name => name !== upsellName);
        } else {
          selectedUpsells.push(upsellName);
        }
        
        updateSummary();
      });
    });

    // Update summary function
    function updateSummary() {
      // Update selected plan display
      document.getElementById('selected-plan').textContent = selectedPlan || 'אנא בחר חבילה';
      
      // Update upsells display
      const upsellsSummary = document.getElementById('upsells-summary');
      const upsellsList = document.getElementById('selected-upsells-list');
      
      if (selectedUpsells.length > 0) {
        upsellsSummary.classList.remove('hidden');
        upsellsList.innerHTML = selectedUpsells.map(upsell => 
          `<span class="upsell-tag">${upsell}</span>`
        ).join('');
      } else {
        upsellsSummary.classList.add('hidden');
      }
      
      // Update start button link
      updateStartButton();
    }

    // Update start button with parameters
    function updateStartButton() {
      const startButton = document.getElementById('start-button');
      
      if (!selectedPlan) {
        startButton.href = '#'; // Disable link if no plan selected
        return;
      }
      
      const upsellParams = selectedUpsells.join(',');
      const planParam = selectedPlan.toLowerCase();
      
      // Create the URL with parameters (you can modify this to match your routing)
      const url = `/contact?package=${planParam}&upsells=${encodeURIComponent(upsellParams)}`;
      startButton.href = url;
    }

    // Initialize summary on page load
    updateSummary();
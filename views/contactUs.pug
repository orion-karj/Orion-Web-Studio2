extends base.pug

block content
  style.
    @import url('https://fonts.googleapis.com/css2?family=Varela+Round&display=swap');

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      color: white;
      
    }


    .hero {
    text-align: center;
    padding: 6rem 1rem 4rem;
    position: relative;
    background: none;
    }

    .hero h1 {
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1.2;
    background: linear-gradient(to right, #00ffcc, #00ff88);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: fadeInUp 1s ease-out;
    }

    .hero p {
    font-size: 1.2rem;
    color: #bbb;
    margin-top: 1rem;
    animation: fadeInUp 1.5s ease-out;
    }

    .cta {
    margin-top: 2rem;
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    }

    .cta button {
    border: none;
    padding: 0.8rem 1.6rem;
    font-weight: 600;
    font-size: 1rem;
    border-radius: 999px;
    cursor: pointer;
    transition: 0.3s ease;
    }

    .cta button:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0, 255, 136, 0.25);
    }

    .cta button.green {
    background: #d1ffe7;
    color: #166534;
    }

    @keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
    }


    .contact-wrapper {
        direction: rtl;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 2rem;
      padding: 4rem 1rem;
    }

    .form-card {
      background: rgba(77, 77, 77, 0.16);
      backdrop-filter: blur(12px);
      padding: 2rem;
      border-radius: 20px;
      width: 100%;
      max-width: 600px;
      color: #fff;
      box-shadow: 0 0 20px rgba(0,255,136,0.1);
    }

    form {
      display: grid;
      gap: 1rem;
    }

    input, textarea {
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(0,255,136,0.3);
      border-radius: 10px;
      padding: 0.8rem;
      color: #fff;
      font: sans-serif;
    }

    textarea {
        font-family: inherit;
       font-size: inherit;
    }

    input::placeholder,
    textarea::placeholder {
      color: #aaa;
      font: sans-serif;
    }

    button[type="submit"] {
      background: #03743bff;
      color: white;
      font-weight: bold;
      padding: 0.8rem;
      border: none;
      border-radius: 10px;
      cursor: pointer;
    }

    .spinner {
      display: inline-block;
      width: 1em;
      height: 1em;
      border: 2px solid #fff;
      border-top-color: #00ff88;
      border-radius: 50%;
      animation: spin 1s linear infinite;
      vertical-align: middle;
      margin-left: 0.5rem;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    .success-message {
      color: #00ff88;
      margin-top: 1rem;
      font-weight: bold;
    }

    .info-card {
      background: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(10px);
      border-radius: 12px;
      padding: 1rem;
      display: flex;
      align-items: center;
      gap: 1rem;
      width: 100%;
      max-width: 280px;
      transition: ease-in 0.3s;
    }

    .info-card.hover:hover {
        background-color: #03743bff;
    }

    .info-grid {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .info-card svg {
      width: 40px;
      height: 40px;
    }

    .info-card span {

    }

    .cta button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem; /* space between icon and text */
    color: black;
    }


    .line1 {
      font-size: 2.5rem;
      background-image: linear-gradient(to left, #d1fae5, #86efac, #34d399);
    }

    .line2 {
      font-size: 3rem;
      background-image: linear-gradient(to left, #34d399, #39da74ff, #10b95cff);
    }

    .line3 {
      font-size: 3rem;
      position: relative;
      background-image: linear-gradient(to left, #10b95cff, #0b9449ff, #056d34ff);
    }

    .hero-title {
      text-align: center;
      font-weight: bold;
      line-height: 1.2;
      margin-top: 5rem;
    }

    .hero-title span {
      display: block;
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
    }


    .sparkle {
      position: absolute;
      width: 2rem;
      height: 2rem;
      color: #facc15;
      animation: pulse 2.5s infinite;
    }

    .sparkle-left {
      top: -2.40rem;
      left: -1.7rem;
    }

    .sparkle-right {
      top: -2.40rem;
      right: -1.7rem;
    }

    @keyframes pulse {
      0%, 100% {
        opacity: 1;
        transform: scale(1);
      }
      50% {
        opacity: 0.6;
        transform: scale(1.2);
      }
    }

    @media (min-width: 1024px) {
        .contact-wrapper {
            justify-content: space-between;
            align-items: flex-start;
            }

        .form-card {
            flex: 1 1 60%;
            max-width: none;
            }

        .info-grid {
            flex: 1 1 35%;
        }

        .line1 {
            font-size: 3rem;

        }

        .line2 {
            font-size: 4.5rem;

        }

        .line3 {
            font-size: 3.5rem;
            position: relative;
        }

        .sparkle-left {
          top: -0.75rem;
          left: -1rem;
        }

        .sparkle-right {
          top: -0.75rem;
          right: -1rem;
        }
    }

    .subtext {
      margin-top: 2rem;
      font-size: 1.25rem;
      color: #d1d5db;
      max-width: 768px;
      margin-left: auto;
      margin-right: auto;
      line-height: 1.6;
    }

    .subtext .highlight {
      color: #15803d;
      font-weight: 600;
    }

    .hero-info-box {
      margin: 3rem auto 0;
      padding: 1.5rem 2rem;
      max-width: 720px;
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.04);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(52, 211, 153, 0.2);
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      box-shadow: 0 0 30px rgba(52, 211, 153, 0.12);
      animation: fadeInUp 2s ease-out;
      transition: transform 0.3s ease;
      direction: rtl;
    }

    .hero-info-box:hover {
      transform: translateY(-5px);
      box-shadow: 0 0 40px rgba(34, 197, 94, 0.25);
    }

    .hero-info-box svg.icon-lightbulb {
      flex-shrink: 0;
      width: 36px;
      height: 36px;
      stroke: #34d399;
      animation: flicker 2.5s infinite ease-in-out;
    }

    .hero-info-box .text-wrapper {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .hero-info-box .heading {
      font-size: 1.3rem;
      font-weight: 700;
      color: #a7f3d0;
      margin: 0;
    }

    .hero-info-box .description {
      color: #e5e7eb;
      font-size: 1rem;
      line-height: 1.6;
    }

    @keyframes flicker {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.7; }
    }

    @media (min-width: 768px) {
      .hero-info-box .heading {
        font-size: 1.5rem;
      }

      .hero-info-box .description {
        font-size: 1.1rem;
      }
    }




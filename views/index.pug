extends base.pug

block content
  style.
    /* Reset and basics */
    section.hero {
      position: relative;
      overflow: hidden;
      background: transparent;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: transparent;
      margin-bottom: 100px;
      min-height: 100vh; /* Ensure full viewport height */
    }

    /* Radial background covering full screen */
    section.hero .bg-radial {
    position: fixed; /* fixed so it stays on viewport */
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    opacity: 0.25;
    background: radial-gradient(circle at center, rgba(16, 185, 129, 0.15), transparent 70%);
    pointer-events: none;
    transition: background 0.3s ease;
    z-index: 0;
    }

    /* Grid line backgrounds covering full screen */
    section.hero .grid-bg1,
    section.hero .grid-bg2 {
    position: fixed; /* fixed to viewport */
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 0;
    background-repeat: repeat;
    animation: gridPulse 10s ease-in-out infinite;
    }

    /* First grid layer: smaller grid, light green lines */
    section.hero .grid-bg1 {
    background-size: 50px 50px;
    background-image:
        linear-gradient(to right, rgba(16, 185, 129, 0.08) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(16, 185, 129, 0.08) 1px, transparent 1px);
    }

    /* Second grid layer: larger grid, lighter green lines, reverse animation */
    section.hero .grid-bg2 {
    background-size: 50px 50px;
    background-image:
        linear-gradient(to right, rgba(34, 197, 94, 0.05) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(34, 197, 94, 0.05) 1px, transparent 1px);
    animation-direction: reverse;
    }

    /* Grid pulse animation: subtle fade in/out */
    @keyframes gridPulse {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 0.7; }
    }


    /* Floating elements container */
    section.hero .floating-elements {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    }

    /* Individual floating elements with pulse + float */
    section.hero .floating-element {
    position: absolute;
    filter: blur(4px);
    animation: floatPulse 6s ease-in-out infinite;
    }

    /* Floating pulse and float animation */
    @keyframes floatPulse {
    0%, 100% {
        opacity: 0.2;
        transform: translateY(0) scale(1);
    }
    50% {
        opacity: 0.8;
        transform: translateY(-10px) scale(1.1);
    }
    }

    /* Star floating element style */
    section.hero .star {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.6), rgba(34, 197, 94, 0.6), rgba(6, 182, 212, 0.4));
    border-radius: 2px;
    box-shadow: 0 0 10px rgba(16, 185, 129, 0.3);
    }

    /* Circle floating element style */
    section.hero .circle {
    background: linear-gradient(90deg, rgba(34, 197, 94, 0.5), rgba(16, 185, 129, 0.5), rgba(6, 182, 212, 0.3));
    border-radius: 50%;
    box-shadow: 0 0 8px rgba(34, 197, 94, 0.3);
    }


    /* Container */
    section.hero .container {
      position: relative;
      z-index: 10;
      width: 100%;
      max-width: 1200px;
      margin: 0 auto; /* Remove top margin that was pushing it down */
      margin-top: 5rem;
      padding: 0 2rem;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    /* Enhanced heading with icon */
    section.hero .heading-wrapper {
      display: inline-flex;
      align-items: center;
      gap: 1.5rem;
      margin-bottom: 2rem;
      justify-content: center;
    }

    section.hero .icon-box {
    width: 4.5rem;
    height: 4.5rem;
    background: linear-gradient(135deg, #10b981, #059669, #047857, #0d9488);
    border-radius: 1.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: 
        0 25px 50px rgba(4, 120, 87, 0.4),
        0 0 0 1px rgba(255, 255, 255, 0.1);
    transform: rotate(3deg);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    z-index: 1;
    }


    
    section.hero .icon-box:hover {
      transform: rotate(6deg) scale(1.05);
      box-shadow: 
        0 35px 70px rgba(4, 120, 87, 0.5),
        0 0 0 1px rgba(255, 255, 255, 0.2);
    }
    
    section.hero .icon-box svg {
      width: 2.5rem;
      height: 2.5rem;
      filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));
    }
    


    @keyframes iconGlow {
      0%, 100% { opacity: 0.5; transform: scale(0.8); }
      50% { opacity: 1; transform: scale(1.2); }
    }

    /* UPDATED H1 STYLES - Much bigger and better for mobile */
    section.hero h1 {
      font-family: system-ui, -apple-system, sans-serif;
      font-weight: 900;
      font-size: 4.5rem; /* Increased from 2.7rem */
      line-height: 1.1;
      letter-spacing: -0.02em; /* Tighter letter spacing for large text */
      background: linear-gradient(135deg, #34d399, #10b981, #059669, #0d9488);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      display: inline-block;
      text-shadow: 0 0 30px rgba(16, 185, 129, 0.3);
      position: relative;
      margin-bottom: 0.5rem;
      transition: all 0.3s ease;
    }

    /* Add a subtle hover effect for h1 */
    section.hero h1:hover {
      transform: scale(1.02);
      filter: drop-shadow(0 0 25px rgba(16, 185, 129, 0.4));
    }

    /* Fixed subheading - this was the main issue */
    section.hero h2 {
      font-weight: 900;
      font-size: 3.3rem;
      font: sans;
      font-weight: bold;
      line-height: 1.1;
      margin-bottom: 2rem;
      background: linear-gradient(135deg, #d9f99d, #86efac, #22c55e, #16a34a);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      position: relative;
      display: inline-block;
      transition: all 0.5s ease;
      direction: rtl;
      text-align: center;
    }
    
    section.hero h2.glow {
      filter: drop-shadow(0 0 20px rgba(16,185,129,0.8));
      transform: scale(1.02);
    }
    
    /* Fixed highlight spans - positioned behind text, not over it */
    section.hero h2 .text-with-highlight {
    background: linear-gradient(135deg, #d9f99d, #86efac, #22c55e, #16a34a);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        display: inline-block;
        position: relative;
    }

    
    section.hero h2 .highlight {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 110%;
      height: 120%;
      background: linear-gradient(135deg, rgba(34, 197, 94, 0.2), rgba(16, 185, 129, 0.3));
      border-radius: 1rem;
      filter: blur(8px);
      animation: highlightPulse 3s ease-in-out infinite;
      z-index: -1;
    }

    @keyframes highlightPulse {
      0%, 100% { opacity: 0.3; transform: translate(-50%, -50%) scale(0.9); }
      50% { opacity: 0.7; transform: translate(-50%, -50%) scale(1.1); }
    }

    /* Enhanced paragraph */
    section.hero p {
      font-weight: 400;
      font-size: 1.3rem;
      max-width: 45rem;
      margin: 0 auto 3rem;
      line-height: 1.6;
      color: #cbd5e1;
      direction: rtl;
      text-align: center;
    }
    
    section.hero p strong {
      background: linear-gradient(135deg, #86efac, #22c55e, #16a34a);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      font-weight: 700;
      position: relative;
      display: inline-block;
    }
    
    section.hero p strong::after {
      content: '';
      position: absolute;
      left: 0;
      bottom: -0.25rem;
      width: 100%;
      height: 0.3rem;
      background: linear-gradient(90deg, #10b981, #22c55e, #16a34a);
      border-radius: 9999px;
      opacity: 0.7;
      animation: underlinePulse 2s ease-in-out infinite;
    }

    @keyframes underlinePulse {
      0%, 100% { opacity: 0.4; transform: scaleX(0.8); }
      50% { opacity: 1; transform: scaleX(1.1); }
    }

    /* Enhanced features */
    section.hero .features {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 1.05rem;
      max-width: 900px;
      margin: 0 auto 4rem;
      direction: rtl;
    }
    
    section.hero .feature-item {
      position: relative;
      background: rgba(16, 185, 129, 0.1);
      border: 1px solid rgba(16, 185, 129, 0.3);
      border-radius: 1rem;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.8rem;
      width: 180px;
      height : 70px;
      cursor: default;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      backdrop-filter: blur(10px);
      box-shadow: 0 8px 32px rgba(16, 185, 129, 0.1);
      color: #86efac;
      font-size: 0.9rem;
      font-weight: 600;
    }
    
    section.hero .feature-item:hover {
      transform: scale(1.05) rotate(1deg);
      box-shadow: 0 20px 40px rgba(16, 185, 129, 0.3);
      background: rgba(16, 185, 129, 0.2);
      border-color: rgba(34, 197, 94, 0.6);
    }
    
    section.hero .feature-icon {
      width: 2.5rem;
      height: 2.5rem;
      background: linear-gradient(135deg, #22c55e, #10b981, #0d9488);
      border-radius: 1rem;
      display: flex;
      justify-content: center;
      align-items: center;
      color: black;
      font-size: 1.3rem;
      flex-shrink: 0;
      box-shadow: 0 4px 15px rgba(34, 197, 94, 0.4);
      transition: all 0.3s ease;
    }

    section.hero .feature-item:hover .feature-icon {
      transform: scale(1.1) rotate(5deg);
      box-shadow: 0 6px 20px rgba(34, 197, 94, 0.6);
    }

        /* Container */
    section.hero .btn-group {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem; /* slightly smaller gap */
    max-width: 700px;
    margin: 0 auto 4rem;
    direction: rtl;
    }

    /* Common button styles */
    section.hero a.btn-primary,
    section.hero a.btn-secondary {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 240px;       /* match Tailwind min-w */
    padding: 1.25rem 2.5rem; /* px-10 = 2.5rem, py-5 = 1.25rem */
    border-radius: 1.5rem;  /* rounded-3xl approx 24px */
    font-weight: 400;
    font-size: 1.125rem;    /* text-base ~18px */
    text-decoration: none;
    cursor: pointer;
    overflow: hidden;
    transition:
        transform 0.5s ease,
        box-shadow 0.5s ease,
        color 0.5s ease,
        background-color 0.5s ease,
        border-color 0.5s ease;
    z-index: 1;
    gap: 0.75rem;           /* spacing between icon and text */
    }

    /* Primary button */
    section.hero a.btn-primary {
    background: linear-gradient(
        to right,
        #10b981,   /* from-emerald-500 */
        #16a34a,   /* via-green-600 */
        #047857    /* to-emerald-700 */
    );
    color: white;
    box-shadow:
        0 25px 50px rgba(16, 185, 129, 0.25);
    }

    /* Hover effect primary */
    section.hero a.btn-primary:hover,
    section.hero a.btn-primary:focus {
    transform: scale(1.1) rotate(-6deg);
    box-shadow:
        0 35px 75px rgba(16, 185, 129, 0.5);
    outline: none;
    }

    /* Secondary button */
    section.hero a.btn-secondary {
    background: linear-gradient(to right, rgba(255,255,255,0.05), rgba(16,185,129,0.05));
    backdrop-filter: blur(10px);
    border: 3px solid #34d399; /* border-emerald-400 */
    color: #86efac;            /* text-emerald-300 */
    box-shadow: 0 10px 30px rgba(16, 185, 129, 0.15);
    }

    /* Hover effect secondary */
    section.hero a.btn-secondary:hover,
    section.hero a.btn-secondary:focus {
    color: white;
    background: linear-gradient(to right, rgba(16, 185, 129, 0.15), rgba(16, 185, 129, 0.25));
    border-color: #10b981; /* border-emerald-500 */
    transform: scale(1.1) rotate(6deg);
    box-shadow: 0 20px 50px rgba(16, 185, 129, 0.4);
    outline: none;
    }

    /* Icon inside buttons (span) */
    section.hero a span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    position: relative;
    z-index: 10;
    }

    /* Animations for icons (simulate pulse and rotation) */
    section.hero a.btn-primary span > .sparkle-icon {
    animation: pulse 2s infinite ease-in-out;
    }

    section.hero a.btn-primary:hover span > .rocket-icon {
    transform: translateX(0.25rem);
    transition: transform 0.5s ease;
    }

    section.hero a.btn-secondary:hover span > .globe-icon {
    transform: rotate(180deg);
    transition: transform 0.5s ease;
    }

    /* Keyframes pulse */
    @keyframes pulse {
    0%, 100% {
        opacity: 1;
        transform: scale(1);
    }
    50% {
        opacity: 0.7;
        transform: scale(1.1);
    }
    }


    /* Enhanced scroll indicator */
    section.hero .scroll-indicator {
      display: flex;
      flex-direction: column;
      align-items: center;
      cursor: pointer;
      user-select: none;
      margin-bottom: 2rem;
      color: #22c55e;
            font: sans;
      font-weight: bold;
      font-size: 0.9rem;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      transition: all 0.3s ease;
      direction: rtl;
      position: relative;
      z-index: 10;
      gap: 1rem;
    }
    
    section.hero .scroll-indicator:hover {
      color: #86efac;
      transform: translateY(-5px);
    }
    
    section.hero .scroll-indicator .mouse {
      width: 35px;
      height: 60px;
      border: 3px solid #22c55e;
      border-radius: 35px;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      background: linear-gradient(180deg, rgba(16,185,129,0.2), transparent);
      backdrop-filter: blur(10px);
      position: relative;
      transition: all 0.3s ease;
      box-shadow: 0 5px 15px rgba(34, 197, 94, 0.3);
    }
    
    section.hero .scroll-indicator:hover .mouse {
      border-color: #86efac;
      transform: scale(1.1);
      box-shadow: 0 8px 25px rgba(34, 197, 94, 0.5);
    }
    
    section.hero .scroll-indicator .mouse-bounce {
      width: 10px;
      height: 18px;
      margin-top: 15px;
      background: linear-gradient(180deg, #86efac, #22c55e);
      border-radius: 9999px;
      animation: bounce 2s infinite ease;
      box-shadow: 0 0 10px rgba(34, 197, 94, 0.5);
    }
    
    @keyframes bounce {
      0%, 100% { transform: translateY(0); opacity: 1; }
      50% { transform: translateY(15px); opacity: 0.7; }
    }

    /* IMPROVED RESPONSIVE DESIGN */
    @media (max-width: 768px) {
      section.hero .container {
        padding: 0 1.5rem;
        margin-top: 3rem;
      }
      
      section.hero .heading-wrapper {
        gap: 1rem;
        margin-bottom: 1.5rem;
      }
      
      section.hero h1 { 
        font-size: 3.5rem; /* Still quite large on tablets */
        letter-spacing: -0.01em;
      }
      
      section.hero h2 { 
        font-size: 2.8rem; 
      }
      
      section.hero p { 
        font-size: 1.1rem; 
        margin-bottom: 2.5rem;
      }
      
      section.hero .features { 
        gap: 1rem; 
        max-width: 100%;
      }
      
      section.hero .feature-item {
        width: calc(50% - 0.5rem);
        min-width: 160px;
      }
      
      section.hero .btn-group { 
        gap: 1rem; 
        margin-bottom: 3rem;
      }
      
      section.hero a.btn-primary,
      section.hero a.btn-secondary { 
        min-width: 250px; 
        padding: 1.2rem 2rem; 
      }
    }

    /* ENHANCED MOBILE STYLES */
    @media (max-width: 480px) {
      section.hero .container {
        padding: 0 1rem;
        margin-top: 2rem;
      }
      
      section.hero .heading-wrapper { 
        flex-direction: row; 
        gap: 0.75rem;
        margin-bottom: 1rem;
      }
      
      section.hero .icon-box { 
        display: none;
      }
      
      section.hero .icon-box svg {
        display: none;
      }
      
      section.hero h1 { 
        font-size: 2.8rem; /* Much bigger than before (was 2rem) */
        letter-spacing: -0.01em;
        line-height: 1.05;
        margin-bottom: 0.75rem;
      }
      
      section.hero h2 { 
        font-size: 2.2rem; /* Bigger than before */
        line-height: 1.1;
        margin-bottom: 1.5rem;
      }
      
      section.hero p {
        font-size: 1rem;
        line-height: 1.5;
        margin-bottom: 2rem;
        max-width: 100%;
      }
      
      section.hero .features { 
        flex-direction: column; 
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 2.5rem;
      }
      
      section.hero .feature-item {
        width: 100%;
        max-width: 280px;
        height: 65px;
      }
      
      section.hero .btn-group { 
        flex-direction: column; 
        align-items: center;
        gap: 1rem;
        margin-bottom: 2rem;
      }
      
      section.hero a.btn-primary,
      section.hero a.btn-secondary {
        width: 100%;
        max-width: 300px;
        min-width: unset;
        padding: 1.1rem 1.5rem;
        font-size: 1rem;
      }
      
      section.hero .scroll-indicator {
        margin-bottom: 1rem;
        transform: scale(0.9);
      }
    }

    /* EXTRA SMALL SCREENS */
    @media (max-width: 320px) {
      section.hero h1 {
        font-size: 2.4rem;
      }
      
      section.hero h2 {
        font-size: 1.9rem;
      }
      
      section.hero .icon-box {
        width: 3rem;
        height: 3rem;
      }
      
      section.hero .icon-box svg {
        width: 1.75rem;
        height: 1.75rem;
      }
    }

  script.
    // Enhanced floating elements and mouse reactive gradients
    (function(){
      const floatingElementsContainer = document.querySelector('.floating-elements');
      const bgRadial = document.querySelector('.bg-radial');
      let floatingElements = [];
      const count = 40;

      // Generate enhanced floating elements
      for(let i = 0; i < count; i++) {
        const el = document.createElement('div');
        el.classList.add('floating-element');
        
        if (Math.random() > 0.6) {
          el.classList.add('star');
          el.style.transform = `rotate(${Math.random() * 360}deg)`;
        } else {
          el.classList.add('circle');
        }
        
        el.style.left = (Math.random() * 100) + '%';
        el.style.top = (Math.random() * 100) + '%';
        const size = (Math.random() * 8) + 3;
        el.style.width = size + 'px';
        el.style.height = size + 'px';
        el.style.opacity = (Math.random() * 0.8 + 0.2).toFixed(2);
        el.style.animationDelay = (Math.random() * 5).toFixed(2) + 's';
        el.style.animationDuration = ((Math.random() * 6) + 4).toFixed(2) + 's';
        
        floatingElementsContainer.appendChild(el);
        floatingElements.push(el);
      }

      // Enhanced mouse position tracking
      let mouseX = window.innerWidth / 2;
      let mouseY = window.innerHeight / 2;

      window.addEventListener('mousemove', (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
        requestAnimationFrame(updateBackground);
      });

      // Enhanced radial gradient background
      function updateBackground() {
        const gradients = [
          `radial-gradient(800px circle at ${mouseX}px ${mouseY}px, rgba(16, 185, 129, 0.15), transparent 50%)`,
          `radial-gradient(600px circle at ${mouseX + 200}px ${mouseY + 150}px, rgba(34, 197, 94, 0.1), transparent 50%)`,
          `radial-gradient(400px circle at ${mouseX - 100}px ${mouseY - 100}px, rgba(6, 182, 212, 0.08), transparent 40%)`
        ];
        bgRadial.style.background = gradients.join(', ');
      }

      updateBackground();

      // Enhanced text glow animation
      const h2 = document.querySelector('section.hero h2');
      let glow = false;
      setInterval(() => {
        glow = !glow;
        if(glow) {
          h2.classList.add('glow');
        } else {
          h2.classList.remove('glow');
        }
      }, 4000);

      // Smooth scroll for scroll indicator
      document.querySelector('.scroll-indicator').addEventListener('click', () => {
        window.scrollBy({
          top: window.innerHeight,
          behavior: 'smooth'
        });
      });

    })();

    

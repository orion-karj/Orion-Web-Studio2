doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Navigation Component
    style.
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        min-height: 100vh;
      }

      .nav {
        background: rgba(0, 0, 0, 0.2);
        backdrop-filter: blur(8px);
      }

      .nav-container {
        width: 100%;
        padding: 0 1rem;
      }

      @media (min-width: 640px) {
        .nav-container {
          padding: 0 1.5rem;
        }
      }

      @media (min-width: 1024px) {
        .nav-container {
          padding: 0 2rem;
        }
      }

      .nav-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        height: 4rem;
      }

      .logo {
        flex-shrink: 0;
        width: 4.5rem;
      }

      .logo a {
        color: #4ade80;
        font-size: 1.5rem;
        font-weight: bold;
        text-decoration: none;
        display: block;
      }

      .logo img {
        width: 100%;
        height: auto;
      }

      .desktop-nav {
        display: none;
      }

      @media (min-width: 768px) {
        .desktop-nav {
          display: block;
        }
      }

      .nav-links {
        display: flex;
        align-items: baseline;
        gap: 2rem;
      }

      .nav-link {
        position: relative;
        color: white;
        padding: 0.5rem 1rem;
        font-size: 3rem;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.5s ease-out;
        display: block;
      }

      .nav-link:hover span {
        color: white;
        transform: scale(1.05) translateY(-2px);
      }

      .nav-link span {
        font-size: 1rem;
        position: relative;
        z-index: 10;
      }

      .nav-link-bg {
        position: absolute;
        inset: 0;
        background: linear-gradient(to right, #22c55e, #16a34a);
        border-radius: 0.5rem;
        opacity: 0;
        transition: all 0.5s ease-out;
        transform: scale(0.75);
        filter: blur(4px);
      }

      .nav-link:hover .nav-link-bg {
        opacity: 1;
        transform: scale(1);
        filter: blur(0);
      }

      .mobile-menu-btn {
        display: block;
      }

      @media (min-width: 768px) {
        .mobile-menu-btn {
          display: none;
        }
      }

      .menu-toggle {
        color: white;
        background: none;
        border: none;
        padding: 0.5rem;
        border-radius: 0.375rem;
        cursor: pointer;
        transition: color 0.3s ease;
        font-size: 2.2rem;
        line-height: 1;
      }

      .menu-toggle:hover {
        color: #166534;
      }

      .menu-toggle:focus {
        outline: 2px solid #166534;
        outline-offset: 2px;
      }

      .mobile-nav {
        display: none;
        padding: 0.5rem;
        padding-top: 0.5rem;
        padding-bottom: 0.75rem;
        background: rgba(0, 0, 0, 0.3);
        border-radius: 0.5rem;
        margin-top: 0.5rem;
      }

      .mobile-nav.open {
        display: block;
      }

      @media (min-width: 768px) {
        .mobile-nav {
          display: none !important;
        }
      }

      @media (min-width: 640px) {
        .mobile-nav {
          padding: 0.75rem;
        }
      }

      .mobile-nav-links {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }

      .mobile-nav-link {
        position: relative;
        color: white;
        display: block;
        padding: 0.75rem 1rem;
        font-size: 1rem;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.5s ease-out;
        text-align: right;
      }

      .mobile-nav-link:hover {
        color: white;
        transform: scale(1.05);
      }

      .mobile-nav-link span {
        position: relative;
        z-index: 10;
      }

      .mobile-nav-link .nav-link-bg {
        background: linear-gradient(to right, #10b981, #4ade80);
      }

  body
    nav.nav
      .nav-container
        .nav-content
          //- Logo
          .logo
            a(href="/")
              img(src="/assets/panda-white.png", alt="logo")

          //- Desktop Navigation Links  
          .desktop-nav
            .nav-links
              a.nav-link(href="/contact")
                span יצירת קשר
                .nav-link-bg
              a.nav-link(href="/services")
                span שירותים ומחירים
                .nav-link-bg
              a.nav-link(href="/about")
                span עלינו
                .nav-link-bg
              a.nav-link(href="/")
                span בית
                .nav-link-bg


          //- Mobile menu button
          .mobile-menu-btn
            button.menu-toggle(onclick="toggleMenu()")
              span.menu-icon ☰
              span.close-icon(style="display: none;") ✕

        //- Mobile Navigation Menu
        .mobile-nav#mobileNav
          .mobile-nav-links
            a.mobile-nav-link(href="/", onclick="closeMenu()")
              span בית
              .nav-link-bg
            a.mobile-nav-link(href="/about", onclick="closeMenu()")
              span עלינו
              .nav-link-bg
            a.mobile-nav-link(href="/services", onclick="closeMenu()")
              span שירותים ומחירים
              .nav-link-bg
            a.mobile-nav-link(href="/contact", onclick="closeMenu()")
              span יצירת קשר
              .nav-link-bg

    script.
      let isOpen = false;

      function toggleMenu() {
        isOpen = !isOpen;
        const mobileNav = document.getElementById('mobileNav');
        const menuIcon = document.querySelector('.menu-icon');
        const closeIcon = document.querySelector('.close-icon');
        
        if (isOpen) {
          mobileNav.classList.add('open');
          menuIcon.style.display = 'none';
          closeIcon.style.display = 'inline';
        } else {
          mobileNav.classList.remove('open');
          menuIcon.style.display = 'inline';
          closeIcon.style.display = 'none';
        }
      }

      function closeMenu() {
        isOpen = false;
        const mobileNav = document.getElementById('mobileNav');
        const menuIcon = document.querySelector('.menu-icon');
        const closeIcon = document.querySelector('.close-icon');
        
        mobileNav.classList.remove('open');
        menuIcon.style.display = 'inline';
        closeIcon.style.display = 'none';
      }
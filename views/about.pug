extends base

block content2
  style.
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      color: white;
      background-color: #0a0a0a;
      margin: 0;
      padding: 0;
      text-align: center;
    }

    h1, h2, h3 {
      font-weight: 700;
      margin-bottom: 0.5rem;
      direction: rtl;
    }

    .section {
      padding: 4rem 1.5rem;
      max-width: 1200px;
      margin: auto;
      direction: rtl;
    }

    .hero {
      padding: 6rem 1.5rem 4rem;
      direction: rtl;
    }

    .hero h1 {
      font-size: 6rem;
      background: linear-gradient(to right, #139c45, #20b455);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      direction: rtl;
    }

    .tagline {
      display: inline-flex;
      align-items: center;
      color: #22c55e;
      padding: 0.4rem 1rem;
      border-radius: 999px;
      font-size: 0.9rem;
      margin-bottom: 1rem;
      direction: rtl;
      background: #0000003b;
    }

    .tagline svg {
      width: 14px;
      height: 14px;
      fill: #22c55e;
      margin: 0 0.4rem;
    }

    .values-grid, .choose-grid {
      display: grid;
      gap: 1.5rem;
    }

    @media(min-width: 640px) {
      .values-grid { grid-template-columns: repeat(2, 1fr); }
      .choose-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media(min-width: 1024px) {
      .values-grid { grid-template-columns: repeat(4, 1fr); }
    }
    @media(max-width: 640px) {
    .hero h1 {
      font-size: 3rem;
    }
    .hero.section p {
        font-size: 1.1rem;
    }
    }

    .hero.section p {
        font-size: 1.3rem;
    }

    /* Cards for core values */
    .card {
      border-radius: 1rem;
      padding: 2rem 1.5rem;
      transition: all 0.3s ease;
      direction: rtl;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .card:hover {
      border-color: #22c55e;
    }

    .card-icon {
      width: 48px;
      height: 48px;
      margin: 0 auto 1rem;
      background: rgba(16,185,129,0.3);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #22c55e;
      transition: all 0.3s ease;
    }

    .card:hover .card-icon {
      background: #22c55e;
      color: white;
    }

    .card-icon svg {
      width: 24px;
      height: 24px;
      stroke-width: 1.5;
      stroke: #22c55e;
      fill: none;
    }

    /* Redesigned Why Choose Us section */
    .choose-item {
      text-align: right;
      padding: 1rem 1.5rem;
      border-right: 4px solid #22c55e;
      transition: transform 0.2s ease;
    }

    .choose-item:hover {
      transform: translateX(-4px);
    }

    .choose-item h3 {
      font-size: 1.3rem;
      margin-bottom: 0.5rem;
      color: #22c55e;
    }

    .choose-item p {
      color: #d1d5db;
      font-size: 0.95rem;
      line-height: 1.6;
    }

    /* CTA Button */
    .cta-btn {
      display: inline-flex;
      align-items: center;
      background: #22c55e;
      color: white;
      font-weight: 600;
      padding: 0.75rem 1.5rem;
      border-radius: 12px;
      text-decoration: none;
      transition: all 0.3s ease;
      margin: 1rem 0;
    }

    .cta-btn:hover {
      background: #16a34a;
      transform: scale(1.05);
    }

    .cta-links {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      margin-top: 1rem;
      font-size: 0.9rem;
      color: #d1d5db;
    }

    .cta-links a {
      color: #d1d5db;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      transition: color 0.3s ease;
    }

    .cta-links a:hover {
      color: #fff;
    }

    .cta-links svg {
      width: 18px;
      height: 18px;
      stroke-width: 1.5;
      stroke: currentColor;
      fill: none;
    }

    .small-print {
      font-size: 0.75rem;
      color: #9ca3af;
      margin-top: 1.5rem;
    }

